<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== Criar / alterar PIN ===== -->
        <LinearLayout
            android:id="@+id/sectionCreatePin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtCreateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crie o PIN do responsável"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="O PIN (4 a 8 números) protege as configurações e libera tempo extra. Não compartilhe com a criança." />

            <EditText
                android:id="@+id/edtNewPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Novo PIN"
                android:inputType="numberPassword"
                android:maxLength="8" />

            <EditText
                android:id="@+id/edtConfirmPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Confirme o PIN"
                android:inputType="numberPassword"
                android:maxLength="8" />

            <TextView
                android:id="@+id/txtCreateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C62828" />

            <Button
                android:id="@+id/btnCreatePin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Salvar PIN" />
        </LinearLayout>

        <!-- ===== Login do responsável ===== -->
        <LinearLayout
            android:id="@+id/sectionLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Área do responsável"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLoginUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/edtLoginPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="PIN do responsável"
                android:inputType="numberPassword"
                android:maxLength="8" />

            <TextView
                android:id="@+id/txtLoginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C62828" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Entrar" />
        </LinearLayout>

        <!-- ===== Configurações ===== -->
        <LinearLayout
            android:id="@+id/sectionSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tempo de tela hoje"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnExtra30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+30 min hoje" />

                <Button
                    android:id="@+id/btnResetToday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zerar hoje" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Limites diários"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Controle de tempo ativado" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Segunda a sexta (minutos por dia — ex.: 120 = 2 horas)" />

            <EditText
                android:id="@+id/edtWeekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sábado e domingo (minutos por dia)" />

            <EditText
                android:id="@+id/edtWeekend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Salvar limites" />

            <Button
                android:id="@+id/btnPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Testar tela de bloqueio" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para sair do teste: no fim da tela, segure o cadeado (Responsável) por 3 segundos, digite o PIN e toque em Sair do teste."
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Permissões"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Permitir sobrepor outros apps" />

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Permitir notificações" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Ignorar otimização de bateria" />

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Proteger contra desinstalação" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Ativar proteção na Acessibilidade" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Segurança"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Diagnóstico"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ver diagnóstico" />

            <Button
                android:id="@+id/btnDiagClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apagar diagnóstico" />

            <TextView
                android:id="@+id/txtDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnChangePin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alterar PIN" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sair da área do responsável" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
